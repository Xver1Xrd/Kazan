# --- Telegram ---
# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAABBBCCCDDDEEEFFFGGGHHHIIIJJJKKK
# Ваш Telegram user id (владелец бота, полный доступ). Узнать можно у @userinfobot
OWNER_ID=123456789
# Через запятую — id дополнительных пользователей с доступом (необязательно)
ALLOWED_USERS=

# --- База данных ---
# По умолчанию SQLite (файл создаётся автоматически). Для PostgreSQL используйте:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kazan_bot
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# --- Redis (опционально, для хранения FSM вместо памяти процесса) ---
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- Приватный канал для дублирования бэкапов (id канала, бот должен быть админом) ---
BACKUP_CHANNEL_ID=

# --- Безопасность ---
# PIN-код для входа в бота (необязательно). Если задан — бот запросит его при каждом новом сеансе.
PIN_CODE=

# --- Автоматизация ---
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_DAYS=3
LINK_CHECK_ENABLED=true
LINK_CHECK_INTERVAL_HOURS=24
VIDEO_OF_DAY_ENABLED=false
VIDEO_OF_DAY_HOUR=10
TRASH_AUTOCLEAN_DAYS=30
UNCATEGORIZED_REMINDER_THRESHOLD=15

# --- Общие настройки ---
DEFAULT_LOCALE=ru
DEFAULT_PAGE_SIZE=10
TIMEZONE=UTC
LOG_LEVEL=INFO
BACKUPS_DIR=./data/backups
